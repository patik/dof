{
    "name": "dof",
    "version": "3.0.0",
    "type": "module",
    "sideEffects": false,
    "author": {
        "name": "Craig Patik",
        "email": "craig@patik.com",
        "url": "https://patik.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/patik/dof.git"
    },
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bugs": {
        "url": "https://github.com/patik/dof/issues"
    },
    "description": "Depth-of-field calculator for comparing camera lenses",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.19"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "homepage": "https://github.com/patik/dof",
    "keywords": [
        "depth-of-field",
        "lens",
        "camera",
        "sensor",
        "calculator",
        "focal-length",
        "photography",
        "bokeh",
        "focus",
        "blur"
    ],
    "license": "BSD-3-Clause",
    "scripts": {
        "build": "tsdown",
        "clean": "git clean -fdx",
        "cover": "bun run build && cd .. && vitest run --coverage --project package",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && bun run typecheck",
        "format": "biome format --write .",
        "test": "bun run build && cd .. && vitest run --project package",
        "publint": "publint",
        "attw": "attw --pack . --profile esm-only",
        "check:package": "bun run publint && bun run attw"
    },
    "types": "./dist/index.d.ts",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "publint": "^0.3.23",
        "tsdown": "^0.22.14"
    }
}
