{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022"],
        "baseUrl": ".",
        "skipLibCheck": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "moduleResolution": "bundler",
        "typeRoots": ["../node_modules/@types", "types"],
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "resolveJsonModule": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": [
        "../node_modules",
        "node_modules",
        "test",
        "spec",
        "types",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts"
    ]
}
