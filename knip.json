{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": ["@types/react-dom"],
    "workspaces": {
        "app": {
            "entry": ["pages/**/*.{ts,tsx}", "playwright.config.ts"],
            "project": ["src/**/*.{ts,tsx}", "pages/**/*.{ts,tsx}", "e2e/**/*.{ts,tsx}"],
            "ignore": ["src/utilities/sensorList.ts"]
        },
        "package": {
            "entry": ["src/index.ts"],
            "project": ["src/**/*.{ts,tsx}"]
        }
    }
}
