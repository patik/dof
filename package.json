{
    "name": "@patik/dof",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "package",
        "app"
    ],
    "scripts": {
        "dev": "bun run --cwd package tsc && bun run --cwd app dev",
        "start": "bun run --cwd app preview",
        "start:ci": "bun run build && bun run --cwd app preview --host 127.0.0.1 --port 3000",
        "build": "bun run --cwd package lint && bun run --cwd package tsc && bun run --cwd app build",
        "deploy": "bun run --cwd package lint && bun run --cwd package tsc && IS_DEPLOYMENT=true bun run --cwd app build",
        "clean": "git clean -fdx",
        "cover": "vitest run --coverage --project package",
        "lint": "biome check . && bun run typecheck && bun run knip",
        "format": "biome format --write .",
        "typecheck": "bun run --workspaces typecheck",
        "knip": "knip",
        "preversion": "bun run --filter dof preversion",
        "postversion": "git push && git push --tags",
        "test": "vitest run",
        "e2e": "playwright test --config app/playwright.config.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@biomejs/biome": "^2.5.6",
        "@playwright/test": "^1.62.1",
        "@tanstack/router-plugin": "^1.168.23",
        "@types/node": "24.10.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.0.1",
        "knip": "^6.31.0",
        "typescript": "^5.6.2",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/patik/dof.git"
    }
}
