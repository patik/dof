{
    "name": "@patik/dof",
    "version": "4.0.1",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "package",
        "app"
    ],
    "scripts": {
        "dev": "bun run --cwd package tsc && bun run --cwd app dev",
        "start": "bun run --cwd app start",
        "start:ci": "bun run build && bun run --cwd app start",
        "build": "bun run --cwd package lint && bun run --cwd package tsc && bun run --cwd app build",
        "deploy": "bun run --cwd package lint && bun run --cwd package tsc && IS_DEPLOYMENT=true bun run --cwd app build",
        "clean": "git clean -fdx",
        "cover": "bun run --cwd package test --collectCoverage",
        "lint": "bun run --workspaces lint",
        "preversion": "bun run --filter dof preversion",
        "postversion": "git push && git push --tags",
        "test": "bun run --workspaces test",
        "cypress:open": "cypress open --project ./app",
        "postinstall": "patch-package"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@jest/globals": "^30.2.0",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/jest": "^30.0.0",
        "@types/node": "24.10.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.49.0",
        "@typescript-eslint/parser": "^8.49.0",
        "cypress": "^15.7.1",
        "eslint": "9.39.1",
        "eslint-config-next": "16.0.7",
        "eslint-plugin-cypress": "^5.2.0",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "jest": "^30.2.0",
        "jiti": "^2.6.1",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-prune": "^0.10.3",
        "typescript": "^5.6.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/patik/dof.git"
    },
    "dependencies": {
        "patch-package": "^8.0.0"
    }
}
