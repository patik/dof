{
    "name": "@patik/dof",
    "version": "4.0.1",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "package",
        "app"
    ],
    "scripts": {
        "dev": "bun run --cwd package tsc && bun run --cwd app dev",
        "start": "bun run --cwd app start",
        "start:ci": "bun run build && bun run --cwd app start",
        "build": "bun run --cwd package lint && bun run --cwd package tsc && bun run --cwd app build",
        "deploy": "bun run --cwd package lint && bun run --cwd package tsc && IS_DEPLOYMENT=true bun run --cwd app build",
        "clean": "git clean -fdx",
        "cover": "bun run --cwd package test --collectCoverage",
        "lint": "biome check . && bun run typecheck && bun run knip",
        "format": "biome format --write .",
        "typecheck": "bun run --workspaces typecheck",
        "knip": "knip",
        "preversion": "bun run --filter dof preversion",
        "postversion": "git push && git push --tags",
        "test": "bun run --workspaces test",
        "cypress:open": "cypress open --project ./app"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/jest": "^30.0.0",
        "@types/node": "24.10.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "cypress": "^15.7.1",
        "jest": "^30.2.0",
        "knip": "^6.31.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.6.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/patik/dof.git"
    }
}
