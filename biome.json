{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/.next",
            "!**/out",
            "!**/dist",
            "!**/coverage",
            "!**/playwright-report",
            "!**/test-results",
            "!app/src/routeTree.gen.ts",
            "!.github/copilot-instructions.md"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "asNeeded"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useExhaustiveDependencies": "error",
                "useHookAtTopLevel": "error"
            },
            "suspicious": {
                "noApproximativeNumericConstant": "off"
            }
        },
        "domains": {
            "react": "recommended"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
