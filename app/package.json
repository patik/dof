{
    "name": "app",
    "version": "3.0.0",
    "private": true,
    "scripts": {
        "dev": "node ../node_modules/next/dist/bin/next dev",
        "build": "node ../node_modules/next/dist/bin/next build",
        "start": "node ../node_modules/serve/build/main.js out",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && bun run typecheck",
        "format": "biome format --write .",
        "test": "bun run jest"
    },
    "dependencies": {
        "@emotion/react": "^11.11.3",
        "@emotion/styled": "^11.13.0",
        "@fontsource/open-sans": "^5.0.20",
        "@mui/icons-material": "^7.3.6",
        "@mui/material": "^7.3.6",
        "@nivo/line": "^0.99.0",
        "dof": "workspace:*",
        "footinch": "^1.0.2",
        "idb-keyval": "^6.2.1",
        "next": "14.2.0",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "react-error-boundary": "^6.0.0",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "serve": "^14.2.1"
    },
    "config": {
        "basePath": "/dof"
    }
}
