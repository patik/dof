{
    "name": "app",
    "version": "4.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && bun run prerender",
        "preview": "vite preview",
        "prerender": "bun run scripts/prerender.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && bun run typecheck",
        "format": "biome format --write .",
        "test": "vitest run --config ../vitest.config.ts --project app"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@emotion/react": "^11.11.3",
        "@emotion/styled": "^11.13.0",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@mui/icons-material": "^7.3.6",
        "@mui/material": "^7.3.6",
        "@nivo/line": "^0.99.0",
        "@tanstack/react-router": "^1.170.18",
        "dof": "workspace:*",
        "footinch": "^1.0.2",
        "idb-keyval": "^6.2.1",
        "react": "19.2.1",
        "react-dom": "19.2.8",
        "react-error-boundary": "^6.0.0",
        "zustand": "^5.0.9"
    }
